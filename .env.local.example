# Opcional: o app também lê SUPABASE_URL, SUPABASE_ANON_KEY e
# SUPABASE_SERVICE_ROLE_KEY do .env. Use este arquivo para sobrescrever.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor. Nunca exponha no navegador nem faça commit.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# Mercado Pago (checkout de ingressos)
# Painel: https://www.mercadopago.com.br/developers/panel/app
#   → Suas integrações → (sua aplicação) → Credenciais
# Comece com as credenciais de TESTE (começam com "TEST-"); troque pelas
# de produção só quando for abrir as vendas.
# ============================================
# Somente servidor. Nunca exponha no navegador.
MERCADOPAGO_ACCESS_TOKEN=
# Pública: usada no navegador para o formulário de cartão (Checkout Bricks).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Assinatura secreta dos webhooks (Suas integrações → Webhooks → "Assinatura secreta").
MERCADOPAGO_WEBHOOK_SECRET=

# ============================================
# Resend (e-mail com os ingressos) — https://resend.com/api-keys
# Sem domínio verificado, só envia para o e-mail dono da conta Resend.
# ============================================
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: Híbrido Games <ingressos@seudominio.com.br>
EMAIL_FROM=

# ============================================
# Gmail (envio dos e-mails de ingressos) — tem prioridade sobre o Resend
# Senha de app: https://myaccount.google.com/apppasswords (exige verificação em 2 etapas)
# ============================================
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nome exibido como remetente (opcional)
EMAIL_FROM_NAME="Híbrido Games 2026"
